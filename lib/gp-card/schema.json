{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clavametrics.app/schemas/gp.card.v1.json",
  "title": "gp.card/v1",
  "description": "Shared contract for a GPS analysis card. Produced identically by the catalog, the manual builder, and the AI generator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "viz", "metrics", "scope", "range", "style"],
  "properties": {
    "schema": { "const": "gp.card/v1" },
    "title": { "type": "string", "maxLength": 120 },
    "sort": {
      "$comment": "Optional presentation-only sort. Table: { col, dir } per column. Bars: { by:'value'|'label', dir } reorders the categories. Does not change the data.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["dir"],
      "properties": {
        "col": { "type": "string", "$comment": "Table viz: id of the column to sort by." },
        "by": { "type": "string", "enum": ["value", "label"], "$comment": "Bars viz: sort categories by the primary bar value or by the category label." },
        "dir": { "type": "string", "enum": ["asc", "desc"] }
      }
    },
    "viz": {
      "type": "string",
      "enum": ["kpi", "bars", "line", "scatter", "radar", "ranking", "table", "heatmap"]
    },
    "source": {
      "type": "string",
      "enum": ["session", "task"],
      "$comment": "Data source. Absent ⇒ 'session' (gps_reports). 'task' reads v_gps_task_analysis (period×player) and unlocks the task dimensions + per-minute metrics."
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "type": "string", "enum": ["player", "squad"] },
        "playerId": { "type": ["string", "null"] }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "agg"],
        "properties": {
          "id": { "type": "string" },
          "agg": { "type": "string", "enum": ["avg", "wavg", "total", "median", "max", "min"] },
          "kind": { "type": "string", "enum": ["accum", "peak", "calculated"] },
          "unit": { "type": "string" },
          "custom": { "type": "boolean" },
          "name": { "type": "string", "$comment": "Display name, carried for calculated metrics so a saved card renders even without the catalog entry." },
          "formula": { "type": "string", "$comment": "Calculated metric: arithmetic over base metric ids with + - * / ( ) and min/max/abs/round. Evaluated PER SESSION by the controlled parser (never as code), then aggregated like any metric." },
          "line": { "type": "boolean", "$comment": "Bars combo: render this metric as a line on a secondary axis." },
          "rel": { "type": "string", "enum": ["prev_mc"], "$comment": "Relative display mode: 'prev_mc' renders this metric as % change vs the previous microcycle (drawn as a line on a secondary axis). Requires a microcycle dimension on a bars/line viz." },
          "format": {
            "$comment": "Optional per-column conditional formatting (table viz). min/max & thresholds are derived from real data at render; only the rule is stored.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": { "type": "string", "enum": ["plain", "bar", "heat", "icon", "pct"] },
              "dir": { "type": "string", "enum": ["high", "band"] },
              "dec": { "type": "integer", "minimum": 0, "maximum": 3 },
              "label": { "type": "string", "$comment": "Per-card column rename (overrides the catalog name in this card only)." },
              "align": { "type": "string", "enum": ["left", "center", "right"], "$comment": "Per-column content alignment (table viz). Default: measures right." },
              "barColor": { "type": ["string", "null"] },
              "heatScale": { "type": "string", "enum": ["gyr", "ryg", "seq"] },
              "iconStyle": { "type": "string", "enum": ["dot", "arrow"] },
              "thr": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "properties": { "hi": { "type": "number" }, "lo": { "type": "number" } }
              }
            }
          }
        },
        "allOf": [
          {
            "$comment": "Peak rule: peak metrics only allow avg/max/min (sum & median are meaningless).",
            "if": { "properties": { "kind": { "const": "peak" } }, "required": ["kind"] },
            "then": { "properties": { "agg": { "enum": ["avg", "max", "min"] } } }
          }
        ]
      }
    },
    "dimensions": {
      "type": "array",
      "maxItems": 4,
      "$comment": "Grouping/label fields (no aggregation). Tables accept several (composite row key + one column each); other vizzes use the first. Empty ⇒ row/X defaults to player_name.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "enum": ["player_name", "position", "session_date", "md_code", "microcycle", "rival", "drill", "field_size", "players_format"] },
          "label": { "type": "string", "$comment": "Per-card column rename (table viz)." },
          "align": { "type": "string", "enum": ["left", "center", "right"], "$comment": "Per-column content alignment (table viz). Default: left." }
        }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["mc", "w7", "w30", "season", "custom", "allTime"] },
        "from": { "type": "string", "format": "date" },
        "to": { "type": "string", "format": "date" },
        "mcCode": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "$comment": "A custom range requires explicit dates.",
          "if": { "properties": { "type": { "const": "custom" } } },
          "then": { "required": ["from", "to"] }
        }
      ]
    },
    "comparison": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline"],
          "properties": {
            "baseline": { "type": "string", "enum": ["role", "position", "match", "md", "self", "mc"] },
            "method": { "type": "string", "enum": ["avg", "wavg", "zscore"] },
            "refWindow": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type"],
                  "properties": {
                    "type": { "type": "string", "enum": ["season", "lastN"] },
                    "days": { "type": "integer", "minimum": 1 }
                  }
                }
              ]
            },
            "opts": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "topN": { "type": "integer", "minimum": 1 },
                "mdLookback": { "type": "integer", "minimum": 1 }
              }
            },
            "refMcId": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size"],
      "properties": {
        "size": { "type": "string", "enum": ["sm", "md", "lg", "full"] },
        "color": { "type": "string", "pattern": "^#([0-9a-fA-F]{6})$" },
        "palette": { "type": "string", "enum": ["pitch", "heat", "cool", "mono"] },
        "axes": { "type": "boolean" },
        "legend": { "type": "boolean" },
        "dataLabels": { "type": "boolean" },
        "points": { "type": "boolean" },
        "area": { "type": "boolean" },
        "orientation": { "type": "string", "enum": ["vertical", "horizontal"], "$comment": "Bar chart orientation." },
        "stacked": { "type": "boolean", "$comment": "Bar chart: stack series into one bar." },
        "relBands": {
          "type": ["object", "null"],
          "$comment": "Δ% variation colour bands. v≥hi→colors[0], 0≤v<hi→colors[1], lo≤v<0→colors[2], v<lo→colors[3].",
          "additionalProperties": false,
          "properties": {
            "hi": { "type": "number" },
            "lo": { "type": "number" },
            "colors": { "type": "array", "items": { "type": "string" }, "minItems": 4, "maxItems": 4 }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$comment": "KPI and Ranking take exactly one metric.",
      "if": { "properties": { "viz": { "enum": ["kpi", "ranking"] } } },
      "then": { "properties": { "metrics": { "maxItems": 1 } } }
    },
    {
      "$comment": "Bars take one or two metrics.",
      "if": { "properties": { "viz": { "const": "bars" } } },
      "then": { "properties": { "metrics": { "maxItems": 2 } } }
    },
    {
      "$comment": "Scatter takes exactly two metrics (X, Y).",
      "if": { "properties": { "viz": { "const": "scatter" } } },
      "then": { "properties": { "metrics": { "minItems": 2, "maxItems": 2 } } }
    },
    {
      "$comment": "Radar needs three or more metrics.",
      "if": { "properties": { "viz": { "const": "radar" } } },
      "then": { "properties": { "metrics": { "minItems": 3 } } }
    }
  ]
}
